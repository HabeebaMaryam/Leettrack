# =========================
# Server Configuration
# =========================
PORT=3000
NODE_ENV=development

# =========================
# Database Configuration
# =========================
# PostgreSQL database URL
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://habeeba:habeeba@123@localhost:5432/leettrack

# =========================
# Authentication / JWT
# =========================
# Secret key for signing JWT tokens
JWT_SECRET=supersecretjwtkey123
# Token expiration (optional, default can be 1 day)
JWT_EXPIRES_IN=1d
;
; # =========================
; # Frontend / CORS
; # =========================
; # URL of your frontend (for CORS)
; CLIENT_URL=http://localhost:5173
;
; # =========================
; # Optional / WebSockets (if your project uses it)
; # =========================
; WS_URL=ws://localhost:3000/v2
